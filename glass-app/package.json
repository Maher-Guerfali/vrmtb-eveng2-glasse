{
  "name": "vrmtb-glance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Even G2 companion HUD for the VR-MTB virtual tumor board",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "transcribe-server": "powershell -ExecutionPolicy Bypass -File tools/start-transcription-server.ps1",
    "transcribe-server:raw": "node tools/transcription-server.mjs",
    "pack": "npm run build && evenhub pack app.json dist -o vrmtb-glance.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.12",
    "livekit-client": "^2.6.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
